# ─────────────────────────────────────────────────────────────────────────────
# Bharat Terminal — environment template.  Copy to `.env` and fill in.
# NOTHING in this file except VITE_* is ever exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://market:market@localhost:5432/market_ai
DATABASE_POOL_MAX=20
TIMESCALE_ENABLED=true

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_QUOTE_TTL_SECONDS=300

# ── Auth / crypto ────────────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
# MUST decode to exactly 32 bytes (AES-256-GCM key for broker credentials)
CREDENTIAL_ENC_KEY=

# ── Market data providers ────────────────────────────────────────────────────
PRIMARY_PROVIDER=groww
FAILOVER_PROVIDERS=
SHARED_FEED_LICENSED=false

# ─────────────────────────────────────────────────────────────────────────────
# BROKER CREDENTIALS BELONG IN THE APP, NOT HERE.
#   Settings → Market data providers → Configure
# They are AES-256-GCM encrypted at rest and never returned by any endpoint.
# Anything saved there REPLACES the value below outright rather than merging
# with it, so a forgotten entry here cannot silently beat what you typed in
# the UI. The entries below are a fallback for headless deployments and
# background workers that have no user context. Normally, leave them blank.
# ─────────────────────────────────────────────────────────────────────────────

# Groww TradeAPI — key + secret from groww.in/trade-api/api-keys.
# The server mints a daily access token itself from the pair.
# Live quotes, option chains and historical candles require a PAID TradeAPI
# plan on the Groww account — this is a subscription, not a setting on the key.
# On the free tier holdings/positions/orders/margins work and every
# /v1/live-data/* call plus historical candles return 403; generating another
# key grants the same roles. Neither value is the session token from the
# Groww website or app.
GROWW_API_KEY=
GROWW_API_SECRET=
# Alternative to the pair above, if you mint access tokens yourself:
GROWW_ACCESS_TOKEN=

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4000/api/settings/providers/upstox/callback
UPSTOX_ACCESS_TOKEN=

FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_ACCESS_TOKEN=

# Undocumented NSE endpoints. Operator must explicitly opt in and accept the terms.
NSE_PUBLIC_ENABLED=false
NSE_PUBLIC_MIN_INTERVAL_MS=3000

# ── Fundamentals / news ──────────────────────────────────────────────────────
EODHD_API_KEY=
FMP_API_KEY=
MARKETAUX_API_KEY=
NEWSAPI_KEY=
RSS_FEEDS=

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MAX_TOKENS=4096
AI_ENABLED=true

# ── Notifications ────────────────────────────────────────────────────────────
SMTP_URL=
ALERT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Frontend (PUBLIC — never put a secret here) ──────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
